---
Checks: >
  bugprone-*,
  modernize-*,
  readability-*,
  performance-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -readability-identifier-naming,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions

WarningsAsErrors: '*'
HeaderFilterRegex: '^(src|test)/'
FormatStyle: file
ExtraArgs:
  - -std=gnu++17
  # xtensa-lx106-elf-g++ defines this implicitly; host clang doesn't.
  # Without it, `sys/config.h` skips including `xtensa/config/core-isa.h`
  # so XCHAL_* symbols used by the ESP8266 framework headers are missing.
  - -D__XTENSA__=1

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '40'
  - key: readability-identifier-naming.ClassCase
    value: 'CamelCase'
  - key: readability-identifier-naming.FunctionCase
    value: 'camelBack'
  - key: readability-identifier-naming.MemberCase
    value: 'camelBack'
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: '_'
